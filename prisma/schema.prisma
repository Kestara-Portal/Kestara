generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  password  String
  role      String   @default("pencari")
  createdAt DateTime @default(now())
}

model Company {
  id          Int      @id @default(autoincrement())
  name        String
  logo        String?  // URL logo perusahaan
  industry    String
  location    String
  website     String?
  description String   @db.Text
  size        String?  // Misalnya: "50-200 Karyawan"
  createdAt   DateTime @default(now())
  
  // Relasi: Satu perusahaan bisa punya banyak lowongan
  jobs        Job[]
}

model Job {
  id          Int      @id @default(autoincrement())
  title       String
  type        String   // Full-time, Part-time, Internship
  salary      String?
  description String   @db.Text
  requirements String  @db.Text
  createdAt   DateTime @default(now())
  
  // Foreign key ke Company
  companyId   Int
  company     Company  @relation(fields: [companyId], references: [id])
}