    "db:test": "supabase test db",
    "db:push": "supabase db push",
    "db:diff": "supabase db diff",
    "provision:admin": "node --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/provision-admin.mjs",
    "seed:users": "node --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/seed-users.mjs",
