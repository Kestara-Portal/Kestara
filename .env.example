# =============================================================================
# Kestara — Environment Configuration Template
# =============================================================================
# File strategy (Git-ignored; never commit):
#   .env        -> legacy shared defaults that CLI tools read, e.g. Prisma 5
#                  reads ONLY `.env` (not `.env.local`). Put DATABASE_URL here.
#   .env.local  -> Next.js overrides (loaded with higher priority by Next.js)
#                  and Supabase credentials. Preferred for local secrets.
#
# Node scripts load `.env` first, then `.env.local` (so `.env.local` wins),
# matching Next.js priority. The app (Next.js) loads `.env.local` over `.env`.
#
# NEVER commit real credentials, passwords, tokens, private keys, or keys.
# NEVER paste real values into Git, Jira, chat, screenshots, or documentation.
# =============================================================================

# -----------------------------------------------------------------------------
# APPLICATION
# -----------------------------------------------------------------------------
# OPTIONAL / RESERVED. Not currently read by application code; reserved for
# absolute links or explicit auth redirects. Safe to leave as-is locally.
NEXT_PUBLIC_APP_URL="http://127.0.0.1:3000"

# -----------------------------------------------------------------------------
# SUPABASE — TARGET BACKEND (PostgreSQL, Auth, Storage, RLS)
# -----------------------------------------------------------------------------
# These values are provided by the Supabase project dashboard / `supabase status`.
# The project URL and the publishable key are safe for the browser.
NEXT_PUBLIC_SUPABASE_URL="http://127.0.0.1:54321"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="your-publishable-key"

# Legacy fallback (still accepted during transition; prefer the name above):
# NEXT_PUBLIC_SUPABASE_ANON_KEY="your-legacy-anon-key"

# SERVER-ONLY. Never expose through NEXT_PUBLIC_* or client components.
# Used only for narrow, server-side administrative operations.
SUPABASE_SECRET_KEY="your-secret-key"

# Legacy fallback (still accepted during transition; prefer the name above):
# SUPABASE_SERVICE_ROLE_KEY="your-legacy-service-role-key"

# -----------------------------------------------------------------------------
# DEVELOPMENT SCRIPTS (optional; LOCAL development only)
# -----------------------------------------------------------------------------
# Password for synthetic seed users created by `npm run seed:users`.
# Optional: scripts fall back to a documented dev default if unset.
# NEVER reuse a production password here.
# DEV_SEED_PASSWORD="set-a-dev-only-password"

# -----------------------------------------------------------------------------
# LEGACY STACK — MySQL + Prisma + NextAuth (kept until migration is verified)
# -----------------------------------------------------------------------------
# Do not remove until the Supabase replacement has passed regression testing.
# Local development may still use these for the legacy login/register pages.
DATABASE_URL="mysql://root:YOUR_LOCAL_PASSWORD@localhost:3306/kestara_db"
NEXTAUTH_SECRET="replace-with-a-long-random-string"
NEXTAUTH_URL="http://127.0.0.1:3000"
